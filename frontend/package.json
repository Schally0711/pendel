{
	"name": "pendel-frontend",
	"private": true,
	"version": "0.9.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "npm run i18n && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"i18n": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide --strategy localStorage preferredLanguage baseLocale"
	},
	"devDependencies": {
		"@fontsource-variable/inter": "^5.3.0",
		"@inlang/paraglide-js": "^3.0.0",
		"@lucide/svelte": "^1.67.0",
		"@sveltejs/adapter-static": "^4.0.1",
		"@sveltejs/kit": "^3.1.1",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tailwindcss/vite": "^4.3.4",
		"@types/node": "^26.6.6",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.8",
		"tailwindcss": "^4.3.0",
		"typescript": "^6.0.3",
		"vite": "^8.3.5"
	},
	"imports": {
		"#lib/*": "./src/lib/*"
	},
	"dependencies": {
		"uqr": "0.1.3"
	}
}
